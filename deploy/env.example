# AzureLMS — production env namunasi (AWS EC2 + docker compose).
#
# Ishlatish:  cp env.example .env   va qiymatlarni to'ldiring.
#
# `deploy/.env` ikki vazifani bajaradi: docker compose `${...}` ni shu
# fayldan o'qiydi VA uni har bir konteynerga uzatadi. Fayl `.gitignore` da —
# hech qachon commit qilinmaydi. Serverda huquqini toraytiring:
#   chmod 600 deploy/.env
#
# DIQQAT: bu fayl repo ildizidagi `.env.local` bilan almashtirilmasin.
# `.env.local` — lokal ishlab chiqish uchun, bu esa server uchun.

# ---------------------------------------------------------------- profil ---
APP_ENV=production
DEBUG=False
SECURITY_STRICT=True
TIME_ZONE=Asia/Tashkent

# Django `SECRET_KEY`. Yangi qiymat yasash:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Bu kalit almashsa hamma sessiya va parol reset havolasi bekor bo'ladi.
SECRET_KEY=

# Sayt domeni. `ALLOWED_HOSTS` va `CSRF_TRUSTED_ORIGINS` shundan quriladi.
# `ALLOWED_HOSTS` ni QO'LDA yozmang: yozsangiz default ro'yxat butunlay
# almashadi va `127.0.0.1` yo'qoladi — compose'ning `/healthz` tekshiruvi
# `DisallowedHost` (400) bilan yiqiladi va konteyner cheksiz restart bo'ladi.
APP_DOMAIN=lms.example.com
# Canonical domenga redirect qilinadigan DNS alias. Masalan Namecheap'da
# `www` CNAME `APP_DOMAIN` ga qaraydi; Caddy bu host uchun ham TLS oladi.
APP_WWW_DOMAIN=www.lms.example.com

# Let's Encrypt sertifikati uchun (Caddy). Muddati tugashidan oldin
# ogohlantirish shu manzilga keladi.
TLS_EMAIL=azurebekdev@gmail.com

# ------------------------------------------------------------------ baza ---
# `db` — compose servisining nomi, tarmoq ichidagi host. Port tashqariga
# chiqarilmagan.
POSTGRES_USER=azurelms
POSTGRES_PASSWORD=
POSTGRES_DB=azurelms
DATABASE_URL=postgresql://azurelms:PAROL@db:5432/azurelms

# ------------------------------------------------------- cache / broker ---
# Bo'sh qoldirilsa process umuman ko'tarilmaydi (`core/runtime_gate.py`):
# non-local profilda in-memory fallback taqiqlangan, chunki u hech narsani
# buzmasdan messenger WebSocketini va Celery tasklarini jimgina yo'qotardi.
VALKEY_URL=redis://cache:6379/0
# Broker alohida berilmasa `VALKEY_URL` ishlatiladi.
# CELERY_BROKER_URL=redis://cache:6379/1

# -------------------------------------------------------------- telegram ---
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=azureLMSbot
# Majburiy. Bo'sh bo'lsa webhook fail-closed bo'ladi (`bot/views.py`), ya'ni
# hech kim soxta update yubora olmaydi. Yasash:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# -------------------------------------------------------------------- AI ---
# Gemini bepul kvotasi joriy bosqichning qattiq muhandislik cheklovi.
# Modellar `A8` allowlistidan tashqariga chiqmasin
# (`launch-plan/README.md` — A8 model lifecycle).
AI_CHAT_PROVIDER=gemini
AI_FREE_TIER_MODE=True
GEMINI_GROUNDING_ENABLED=False
GEMINI_FREE_MODEL_ALLOWLIST=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# 2026-08-14 owner qarori: DigitalOcean inference yopiq. Provider factory
# `False` da fail-closed ishlaydi — qayta ochilmasin.
AI_ALLOW_DIGITALOCEAN=False

# ----------------------------------------------------------------- email ---
# Console backend productionda RED: xat yuborilgandek ko'rinadi, lekin hech
# kimga bormaydi (Control Center email probe'i aynan shuni ushlaydi).
# Parol tiklash ishlashi uchun haqiqiy SMTP kerak.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AzureLMS <no-reply@lms.example.com>

# ----------------------------------------------------------------- media ---
# Birinchi deployda `False` — public media EBS disk volume'ida, Caddy
# tarqatadi. Bu ataylab: S3 bitta qism ko'proq nosozlik nuqtasi, birinchi
# ishga tushirishda esa har bir qism kamaytirilgani yaxshi.
USE_S3=False

# S3 ga o'tganda (public media uchun; private media baribir Django view orqali):
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=azurelms-media
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ACL'ni qo'ymang: yangi bucketlarda Object Ownership "Bucket owner enforced"
# bo'lib, ACL yuborilgan har qanday upload 400 bilan rad etiladi.
# AWS_DEFAULT_ACL=

# Private media konteyner ichidagi volume yo'li — `docker-compose.prod.yml`
# dagi `private-media` volume'i shu yerga mount qilinadi.
PRIVATE_MEDIA_ROOT=/app/private-media
